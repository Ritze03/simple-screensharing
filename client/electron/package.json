{
  "name": "simple-screensharing-client-electron",
  "private": true,
  "version": "0.1.0",
  "description": "Electron shell for simple-screensharing-client; talks to the src-tauri sidecar's REST+SSE api_server instead of Tauri IPC.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:appimage": "cargo build --release -p simple-screensharing-client-tauri --manifest-path ../Cargo.toml && electron-builder --linux AppImage",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "net.simplescreensharing.client",
    "productName": "simple-screensharing-client",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "**/*",
      "!pw-electron-test.js"
    ],
    "extraResources": [
      { "from": "../frontend", "to": "frontend" }
    ],
    "linux": {
      "target": ["AppImage"],
      "icon": "../src-tauri/icons/icon.png",
      "category": "Network",
      "extraResources": [
        {
          "from": "../target/release/simple-screensharing-client-tauri",
          "to": "sidecar/simple-screensharing-client-tauri"
        }
      ]
    },
    "win": {
      "target": ["portable"],
      "icon": "../src-tauri/icons/icon.ico",
      "extraResources": [
        {
          "from": "../target/x86_64-pc-windows-msvc/release/simple-screensharing-client-tauri.exe",
          "to": "win/bin/simple-screensharing-client-tauri.exe"
        },
        {
          "from": "win-runtime/bin",
          "to": "win/bin"
        },
        {
          "from": "win-runtime/lib/gstreamer-1.0",
          "to": "win/lib/gstreamer-1.0"
        }
      ]
    }
  }
}
