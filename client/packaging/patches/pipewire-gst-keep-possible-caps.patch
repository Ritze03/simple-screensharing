gst: keep pipewiresrc's possible_caps for later format changes

Applied to PipeWire 1.4.2 (Debian 13), src/gst/gstpipewiresrc.c; backports what
PipeWire 1.6 does (gst_caps_replace on connect, cleared in stop()).

pipewiresrc 1.4.2 forgets possible_caps (the caps downstream accepts) as soon as
the first format is negotiated. A producer that fixates a DMA-BUF modifier
itself (SPA_POD_PROP_FLAG_DONT_FIXATE, e.g. xdg-desktop-portal-hyprland) sends a
SECOND SPA_PARAM_Format after that, handle_format_change() finds no
possible_caps, leaves pwsrc->caps NULL and ends the stream with
"stream error: unhandled format". See client/packaging/README.md.

--- a/src/gst/gstpipewiresrc.c
+++ b/src/gst/gstpipewiresrc.c
@@ -982,7 +982,7 @@
   GST_DEBUG_OBJECT (basesrc, "connect capture with path %s, target-object %s",
                     pwsrc->stream->path, pwsrc->stream->target_object);

-  pwsrc->possible_caps = possible_caps;
+  gst_caps_replace (&pwsrc->possible_caps, possible_caps);
   pwsrc->negotiated = FALSE;

   enum pw_stream_flags flags;
@@ -1019,7 +1019,6 @@
   }

   negotiated_caps = g_steal_pointer (&pwsrc->caps);
-  pwsrc->possible_caps = NULL;
   pw_thread_loop_unlock (pwsrc->stream->core->loop);

   if (negotiated_caps == NULL)
@@ -1068,7 +1067,7 @@
 connect_error:
   {
     g_clear_pointer (&pwsrc->caps, gst_caps_unref);
-    pwsrc->possible_caps = NULL;
+    gst_caps_replace (&pwsrc->possible_caps, NULL);
     GST_DEBUG_OBJECT (basesrc, "connect error");
     pw_thread_loop_unlock (pwsrc->stream->core->loop);
     return FALSE;
@@ -1464,6 +1463,7 @@
   pwsrc->eos = false;
   gst_buffer_replace (&pwsrc->last_buffer, NULL);
   gst_caps_replace(&pwsrc->caps, NULL);
+  gst_caps_replace(&pwsrc->possible_caps, NULL);
   pwsrc->transform_value = UINT32_MAX;
   pw_thread_loop_unlock (pwsrc->stream->core->loop);

