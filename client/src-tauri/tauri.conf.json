{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simple-screensharing-client",
  "version": "0.1.0",
  "identifier": "net.simplescreensharing.client",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Simple Screensharing",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
